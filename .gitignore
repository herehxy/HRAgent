# 密钥与本地数据，不入库
config/secrets.json
config/master.key
        #PII 加密主密钥（丢了就解不开历史数据，务必单独备份）
config/imap.secret
        #收信口令/授权码（界面上填，只落本地，绝不提交）
config/smtp.secret
        #发信口令/客户端专用密码（v1.27 起与收信分离，**独立文件**）
        #⚠️ 新增密钥文件时必须同时补三处清单，否则会漏：
        #   ① 本文件 ② HRAgentWebapp.spec 的 datas 白名单 ③ build_release.py 的 SECRETS
        #   （v1.27 加 smtp.secret 时这三处都没同步，是"同一个清单散在多处"的老毛病）
data/workbench.db
data/workbench.db-*
# 回收目录：界面上"删除"的来源简历落到这里（可恢复），属于本地数据不入库
data/removed/
# 自检/验收用的临时目录（跑完即删；万一中断也别提交进来）
data/_selftest_src/
data/_selftest_archive/
out/
__pycache__/
*.pyc

# Python 虚拟环境
.venv/


{
  "_说明": "投递阶段与结论标签的**唯一真源**。改流程只改这份文件，不用改代码、也不用重新打包。order=全部阶段（按流程先后）；pipeline=界面上占看板的在招阶段（不含终态）；terminal=终态；auto_archive_on=到了就自动归档该候选人（前提：他所有投递都已到终点）；outcomes=该阶段允许打的结论标签（取值范围受限，防止出现「已面试·已签约」这种不存在的组合）；actions=该阶段可执行的动作（to=目标阶段，outcome=顺带写的结论，require=软约束——界面提示但不硬拦）。verdict 由 (阶段, 结论) 推导，不另存字段。",
  "order": [
    "全部简历",
    "初筛通过",
    "待面试",
    "已面试",
    "已发放offer",
    "已结束"
  ],
  "pipeline": [
    "全部简历",
    "初筛通过",
    "待面试",
    "已面试",
    "已发放offer"
  ],
  "terminal": [
    "已结束"
  ],
  "auto_archive_on": [
    "已结束"
  ],
  "outcomes": {
    "待面试": [
      "拟录用",
      "不录用"
    ],
    "已面试": [
      "拟录用",
      "不录用"
    ],
    "已发放offer": [
      "已签约",
      "拒签"
    ]
  },
  "actions": {
    "全部简历": [
      {
        "label": "加入初筛通过",
        "to": "初筛通过"
      }
    ],
    "初筛通过": [
      {
        "label": "加入待面试",
        "to": "待面试",
        "require": [
          "interview_unit"
        ],
        "require_hint": "请先在完整档案的「投递记录 → 面试与录用信息」里登记面试单位——它由人事手动填写，不随岗位自动变；填完之后发面试邀请邮件与导出 Excel 都会用这个值。"
      }
    ],
    "待面试": [
      {
        "label": "面试完成",
        "to": "已面试"
      }
    ],
    "已面试": [
      {
        "label": "拟录用",
        "to": "已面试",
        "outcome": "拟录用"
      },
      {
        "label": "不录用",
        "to": "已结束",
        "outcome": "不录用"
      },
      {
        "label": "发出录用函",
        "to": "已发放offer"
      }
    ],
    "已发放offer": [
      {
        "label": "已签约",
        "to": "已发放offer",
        "outcome": "已签约"
      },
      {
        "label": "拒签",
        "to": "已结束",
        "outcome": "拒签"
      }
    ]
  },
  "colors": {
    "全部简历": "#8a94a6",
    "初筛通过": "#3370ff",
    "待面试": "#7b61ff",
    "已面试": "#0f8a6a",
    "已发放offer": "#d97706",
    "已结束": "#86909c"
  },
  "default_stage": "全部简历",
  "thresholds": {
    "pass": 60,
    "hold": 45
  }
}